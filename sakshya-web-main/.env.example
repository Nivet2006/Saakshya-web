# =====================================================
# ASHA Voice Field Register — Next.js Web Configuration
# Copy to .env.local for local development.
# NEVER commit .env or .env.local!
# =====================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Agent 1 FastAPI Voice Backend Endpoints
NEXT_PUBLIC_VOICE_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000

# Supabase Public Client (Safe for browser — Anon Key only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Language & Synthetic Safety Policy
NEXT_PUBLIC_DEFAULT_LANGUAGE=hi-IN
NEXT_PUBLIC_SUPPORTED_LANGUAGES=hi-IN,kn-IN,ta-IN,te-IN,ml-IN,bn-IN,mr-IN,gu-IN,pa-IN,en-IN
NEXT_PUBLIC_SYNTHETIC_DATA_ONLY=true
