rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Sakshya Healthcare Field Register Collections
    match /beneficiaries/{beneficiaryId} {
      allow read, write: if true; // In production, restrict to authenticated ASHA / ANM / Doctor roles
    }

    match /visits/{visitId} {
      allow read, write: if true;
    }

    match /follow_ups/{followUpId} {
      allow read, write: if true;
    }

    match /danger_alerts/{alertId} {
      allow read, write: if true;
    }

    match /immunisations/{itemId} {
      allow read, write: if true;
    }

    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if false;
    }

    match /user_profiles/{profileId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
