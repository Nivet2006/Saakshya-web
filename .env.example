# =====================================================
# ASHA Voice Field Register — Unified Environment Configuration
# Copy to .env (for server) or .env.local (for Next.js web client).
# NEVER commit .env or .env.local!
# =====================================================

# ---------- Next.js Web Client Configuration ----------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Client (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_, NEVER use in browser bundles)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Agent 1 Voice Backend Endpoints
NEXT_PUBLIC_VOICE_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000/ws/voice

# Web App Language Configuration
NEXT_PUBLIC_DEFAULT_LANGUAGE=hi-IN
NEXT_PUBLIC_SUPPORTED_LANGUAGES=hi-IN,kn-IN,ta-IN,en-IN

# Safety / Demo Configuration
SYNTHETIC_DATA_ONLY=true
NEXT_PUBLIC_SYNTHETIC_DATA_ONLY=true

# ---------- Gnani Services (Backend / Agent 1 owned) ----------
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_STT_WS_URL=
GNANI_TTS_WS_URL=

# ---------- LLM Orchestration (Backend / Agent 1 owned) ----------
LLM_PROVIDER=gemini            # gemini | groq | openrouter | openai
LLM_MODEL=                     # leave blank for default fast model
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=                # required only when LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=

# ---------- Server Configuration ----------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_REDACT_PHI=true

# ---------- Voice Pipeline Parameters ----------
DEFAULT_LANGUAGE=hi-IN
SUPPORTED_LANGUAGES=hi-IN,kn-IN,ta-IN,en-IN
AUDIO_SAMPLE_RATE=16000
VAD_THRESHOLD=0.6
BARGE_IN_MIN_SPEECH_MS=300
ENDPOINT_SILENCE_MS=700
DANGER_SIGN_PARTIAL_MATCHING=true
