# =====================================================
# ASHA Voice Field Register: backend environment
# Copy to .env and fill in values. NEVER commit .env
# =====================================================

# ---------- Gnani (STT + TTS) ----------
GNANI_API_KEY=your_gnani_api_key_here
# Verify these against Gnani's docs; Agent 1 will confirm exact values
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_STT_WS_URL=
GNANI_TTS_WS_URL=

# ---------- LLM (primary) ----------
LLM_PROVIDER=gemini            # gemini | groq | openrouter | openai
LLM_MODEL=                     # leave blank to let Agent 1 pick the current fast model
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=                # required only when LLM_PROVIDER=openai

# ---------- LLM (fallback, optional) ----------
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=

# ---------- Server ----------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Never log raw health data
LOG_REDACT_PHI=true

# ---------- Voice pipeline ----------
DEFAULT_LANGUAGE=hi-IN
SUPPORTED_LANGUAGES=hi-IN,kn-IN,ta-IN,en-IN
AUDIO_SAMPLE_RATE=16000
VAD_THRESHOLD=0.6
BARGE_IN_MIN_SPEECH_MS=300
ENDPOINT_SILENCE_MS=700

# ---------- Safety / demo ----------
SYNTHETIC_DATA_ONLY=true
DANGER_SIGN_PARTIAL_MATCHING=true

# ---------- Integration (set after Agent 3 shares them) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
