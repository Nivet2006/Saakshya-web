{
  "openapi": "3.0.3",
  "info": {
    "title": "ASHA Voice Field Register - Backend API Contract",
    "description": "Standardized contract between Agent 1 (FastAPI/Voice backend) and Clients (Web Agent 3 & Android Agent 2)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/v1/sessions": {
      "post": {
        "summary": "Create Voice Session",
        "operationId": "createVoiceSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/visits/validate": {
      "post": {
        "summary": "Validate and Extract Healthcare Fields",
        "operationId": "validateVisitFields",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateVisitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation and extraction result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitDraft"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/danger-signs/check": {
      "post": {
        "summary": "Check Text/Transcript for Deterministic Danger Signs",
        "operationId": "checkDangerSigns",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "transcript": { "type": "string" },
                  "language": { "type": "string", "example": "hi-IN" },
                  "beneficiary_type": { "type": "string", "enum": ["pregnant_woman", "infant", "child", "postnatal_mother", "general"] }
                },
                "required": ["transcript"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Danger sign evaluation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "has_danger_signs": { "type": "boolean" },
                    "alerts": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/DangerAlert" }
                    }
                  },
                  "required": ["has_danger_signs", "alerts"]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "type": "object",
        "properties": {
          "asha_worker_id": { "type": "string" },
          "beneficiary_id": { "type": "string" },
          "language": { "type": "string", "enum": ["hi-IN", "kn-IN", "ta-IN", "en-IN"] },
          "visit_type": { "type": "string", "enum": ["anc", "pnc", "immunisation", "child_health", "general_checkup"] }
        },
        "required": ["asha_worker_id", "language"]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string", "format": "uuid" },
          "websocket_url": { "type": "string" },
          "language": { "type": "string" },
          "status": { "type": "string", "enum": ["initialized", "active", "completed", "expired"] },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["session_id", "websocket_url", "status", "created_at"]
      },
      "ValidateVisitRequest": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string" },
          "transcript": { "type": "string" },
          "current_draft": { "$ref": "#/components/schemas/VisitDraft" }
        },
        "required": ["transcript"]
      },
      "VisitDraft": {
        "type": "object",
        "properties": {
          "draft_id": { "type": "string" },
          "beneficiary_id": { "type": "string" },
          "beneficiary_name": { "type": "string" },
          "visit_type": { "type": "string" },
          "vitals": {
            "type": "object",
            "properties": {
              "weight_kg": { "type": "number", "nullable": true },
              "blood_pressure_sys": { "type": "integer", "nullable": true },
              "blood_pressure_dia": { "type": "integer", "nullable": true },
              "temperature_f": { "type": "number", "nullable": true },
              "hemoglobin_g_dl": { "type": "number", "nullable": true },
              "fetal_heart_rate_bpm": { "type": "integer", "nullable": true }
            }
          },
          "immunisations_administered": {
            "type": "array",
            "items": { "type": "string" }
          },
          "immunisations_due": {
            "type": "array",
            "items": { "type": "string" }
          },
          "ifa_tablets_given": { "type": "integer", "nullable": true },
          "danger_signs_present": { "type": "boolean" },
          "danger_signs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DangerAlert" }
          },
          "missing_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "next_visit_date": { "type": "string", "format": "date", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "read_back_confirmed": { "type": "boolean" }
        },
        "required": ["draft_id", "danger_signs_present", "read_back_confirmed"]
      },
      "DangerAlert": {
        "type": "object",
        "properties": {
          "alert_id": { "type": "string" },
          "beneficiary_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MODERATE"] },
          "category": { "type": "string" },
          "symptom_evidence": { "type": "string" },
          "referral_instruction": { "type": "string" },
          "referral_facility_type": { "type": "string", "enum": ["PHC", "CHC", "DH", "FRU"] },
          "detected_at": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["ACTIVE", "ACKNOWLEDGED", "REFERRED", "RESOLVED"] }
        },
        "required": ["alert_id", "severity", "category", "symptom_evidence", "referral_instruction", "detected_at", "status"]
      }
    }
  }
}
