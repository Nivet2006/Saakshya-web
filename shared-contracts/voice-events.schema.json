{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoiceWebSocketEvents",
  "description": "Standardized WebSocket Event Protocol for streaming STT, LLM extraction, Timbre TTS, and Barge-In",
  "type": "object",
  "oneOf": [
    {
      "title": "ClientSessionStart",
      "properties": {
        "type": { "const": "session_start" },
        "session_id": { "type": "string" },
        "asha_worker_id": { "type": "string" },
        "beneficiary_id": { "type": "string" },
        "language": { "type": "string", "enum": ["hi-IN", "kn-IN", "ta-IN", "en-IN"] },
        "audio_format": { "type": "string", "default": "pcm_16000_s16le" }
      },
      "required": ["type", "session_id", "language", "asha_worker_id"]
    },
    {
      "title": "ClientBargeIn",
      "properties": {
        "type": { "const": "barge_in" },
        "session_id": { "type": "string" },
        "interrupted_at_ms": { "type": "number" },
        "reason": { "type": "string", "default": "user_speech_detected" }
      },
      "required": ["type", "session_id"]
    },
    {
      "title": "ClientVoiceCorrection",
      "properties": {
        "type": { "const": "voice_correction" },
        "session_id": { "type": "string" },
        "field_name": { "type": "string" },
        "target_value": { "type": "string" }
      },
      "required": ["type", "session_id", "field_name"]
    },
    {
      "title": "ClientConfirmVisit",
      "properties": {
        "type": { "const": "confirm_visit" },
        "session_id": { "type": "string" },
        "draft_id": { "type": "string" }
      },
      "required": ["type", "session_id", "draft_id"]
    },
    {
      "title": "ServerSTTPartial",
      "properties": {
        "type": { "const": "stt_partial" },
        "session_id": { "type": "string" },
        "text": { "type": "string" },
        "is_final": { "const": false }
      },
      "required": ["type", "session_id", "text", "is_final"]
    },
    {
      "title": "ServerSTTFinal",
      "properties": {
        "type": { "const": "stt_final" },
        "session_id": { "type": "string" },
        "text": { "type": "string" },
        "is_final": { "const": true },
        "language": { "type": "string" }
      },
      "required": ["type", "session_id", "text", "is_final"]
    },
    {
      "title": "ServerAssistantText",
      "properties": {
        "type": { "const": "assistant_text" },
        "session_id": { "type": "string" },
        "text": { "type": "string" },
        "state": { "type": "string", "enum": ["speaking", "clarifying", "reading_back", "danger_warning"] }
      },
      "required": ["type", "session_id", "text", "state"]
    },
    {
      "title": "ServerTTSAudioChunk",
      "properties": {
        "type": { "const": "tts_audio_chunk" },
        "session_id": { "type": "string" },
        "chunk_index": { "type": "integer" },
        "audio_base64": { "type": "string" },
        "codec": { "type": "string", "enum": ["wav", "mp3", "pcm"] }
      },
      "required": ["type", "session_id", "chunk_index", "audio_base64"]
    },
    {
      "title": "ServerInterrupted",
      "properties": {
        "type": { "const": "interrupted" },
        "session_id": { "type": "string" },
        "active_stream_cancelled": { "type": "boolean" }
      },
      "required": ["type", "session_id"]
    },
    {
      "title": "ServerVisitExtracted",
      "properties": {
        "type": { "const": "visit_extracted" },
        "session_id": { "type": "string" },
        "draft": { "type": "object" }
      },
      "required": ["type", "session_id", "draft"]
    },
    {
      "title": "ServerDangerAlert",
      "properties": {
        "type": { "const": "danger_alert" },
        "session_id": { "type": "string" },
        "alert": { "type": "object" }
      },
      "required": ["type", "session_id", "alert"]
    }
  ]
}
